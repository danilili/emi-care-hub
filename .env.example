VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>
VITE_SUPABASE_PUBLISHABLE_KEY=<anon-key>
# Respaldo a Bitácora (Bridge App Bitacora) — se conserva durante la transición
VITE_N8N_WEBHOOK_ASISTENCIAS=https://<n8n-host>/webhook/lista-asistencias
# POST #1: procesamiento event-driven de asistencia (Presente/Falta)
VITE_N8N_WEBHOOK_ASISTENCIA=https://<n8n-host>/webhook/asistencia-evento
# POST #2: cobranza (solo Presente + pago definido)
VITE_N8N_WEBHOOK_COBRANZA=https://<n8n-host>/webhook/cobranza-evento

# Cobranza V2 multi-tenant (recibo de pago + recordatorio de adeudo en ventana 10:00-18:30)
VITE_N8N_WEBHOOK_COBRANZA_V2=https://<n8n-host>/webhook/cobranza-evento-v2
